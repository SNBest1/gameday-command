{
  "$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
  "files": {
    "includes": [
      "contracts.ts",
      "vitest.config.ts",
      "vitest.perf.config.ts",
      "engine/**",
      "world/**",
      "brain/**",
      "server/**",
      "app/**",
      "scripts/**",
      "!**/node_modules",
      "!**/dist",
      "!world/data",
      "!server/data"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120,
    "lineEnding": "lf"
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "jsxQuoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "linter": {
    "rules": {
      "recommended": true,
      // Rules turned off in B2 because fixing them needs a logic or markup
      // decision rather than a safe fix. The counts are from the first lint run.
      "a11y": {
        "useButtonType": "off", // 105
        "useSemanticElements": "off", // 5
        "noStaticElementInteractions": "off", // 5
        "useKeyWithClickEvents": "off", // 4
        "noAriaHiddenOnFocusable": "off", // 1
        "noNoninteractiveTabindex": "off" // 1
      },
      "correctness": {
        "useExhaustiveDependencies": "off" // 71
      },
      "suspicious": {
        "noArrayIndexKey": "off", // 8
        "useIterableCallbackReturn": "off", // 6
        "noAssignInExpressions": "off", // 4
        "noShadowRestrictedNames": "off", // 1
        "noImplicitAnyLet": "off" // 1
      }
    }
  }
}
