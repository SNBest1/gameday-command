{
  "name": "gameday-command",
  "private": true,
  "type": "module",
  "workspaces": [
    "engine",
    "world",
    "brain",
    "server",
    "app"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:perf": "vitest run --config vitest.perf.config.ts",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "build": "npm run build --workspace @gameday/app",
    "dev": "npm run dev --workspace @gameday/app",
    "serve": "node --env-file-if-exists=.env --watch server/src/index.ts",
    "fetch-map": "node --env-file-if-exists=.env world/scripts/fetch-map.ts",
    "warm": "node --env-file-if-exists=.env scripts/warm-cache.ts",
    "seed:export": "node --env-file-if-exists=.env scripts/seed-export.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=23.6"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  },
  "overrides": {
    "vite": "$vite"
  }
}
