# Gameday Command — every environment variable the code reads, with its default.
# Copy to .env and change only what you need; nothing here is secret, and the
# project runs with this file absent. The server and the scripts load .env
# automatically through Node's --env-file-if-exists=.env.

# --- API server (server/src/index.ts) -------------------------------------
# Port for the Hono API. `npm run dev` proxies /api here.
PORT=8787
# SQLite file holding the decision cache, saved plans and comparisons.
# Created on first run. Ignored by git, along with its -wal/-shm siblings.
DB_PATH=./data/gameday.db
# Where imported stadium maps are saved (server/src/command.ts).
STADIUM_DIR=./data/stadiums
# Maximum concurrent server-side engine runs (default 12). A new run over the
# cap is refused with 503 instead of exhausting the machine.
RUNS_MAX=12

# --- Kev-4B, the fan decision model (server/src/kev.ts) -------------------
# Kev is NOT a chat model: this is a TypeSafe-compatible POST /v1/systemone.
# With Kev down, every decision falls back to DecisionDefaults by design.
# Started with:
#   uv run --extra serve python -m kev.serve --run jaredpalmer/kev-4b --port 8009
KEV_URL=http://127.0.0.1:8009
# Model name as `GET /v1/models` reports it.
KEV_MODEL=kev-latest
# Deadline for the whole /decide call, shared across groups. Defaults to 75% of
# the contract's DECISION_TIMEOUT_MS (2000 ms), leaving the engine headroom to
# fall back inside its own 2 s pause.
KEV_TIMEOUT_MS=1500
# Groups asked at once. Kev serialises on one GPU, so raising this makes a cold
# cache WORSE — 16 answered one key where 4 answered five. Leave it at 4.
KEV_CONCURRENCY=4
# The background warmer has no commander waiting on it, so it gets a long
# deadline and finishes the keys the live call had to default.
KEV_WARM_TIMEOUT_MS=30000

# --- The commander briefing, via Apple's on-device model (server/src/fm.ts)
# `fm serve` is a real Chat Completions server. Always stream:false.
FM_URL=http://127.0.0.1:8080
FM_MODEL=system
FM_TIMEOUT_MS=20000

# --- Scripts ---------------------------------------------------------------
# npm run warm — which API server to warm the cache through, and the crowd size
# to warm it for. Keys depend on the fan mix, so warm at the size you demo at.
SERVER_URL=http://127.0.0.1:8787
WARM_FANS=100000
# Weather to warm: clear, rain-at-kickoff, thunderstorm, snow, fog or heat.
# Weather is part of every decision key, so demo in the weather you warmed.
WARM_WEATHER=clear
# Seconds of no new cached keys that count as settled. Raise it when Kev is
# slow (a 16 GB Mac under memory pressure can take 20 s or more per answer).
WARM_SETTLE_S=15
# npm run seed:export — where to write the seed. Defaults to the shipped file.
SEED_OUT=./server/data/decision-seed.json

# --- OpenStreetMap (stadium search and import, map refetch) ----------------
# npm run fetch-map and /api/stadiums/import use these. Overpass must run in a
# normal terminal: it answers 406 to the Claude Code sandbox's egress proxy.
OVERPASS_URL=https://overpass-api.de/api/interpreter
NOMINATIM_URL=https://nominatim.openstreetmap.org

# --- Operations map (app/src/OpsMap.tsx) -----------------------------------
# MapLibre style URL. The default is keyless OpenFreeMap Positron, built from
# OpenStreetMap data. Leave it empty for the built-in grid basemap only, for
# example an air-gapped install. Vite inlines VITE_* values at build time.
# On premises, point this at a self-hosted MapLibre style whose source is
# `pmtiles://https://host/basemap.pmtiles`; the app registers the pmtiles
# protocol itself.
VITE_MAP_STYLE=https://tiles.openfreemap.org/styles/positron
# Dark-mode style. Defaults to keyless OpenFreeMap Dark. Override this for an
# on-premises style, or point it at the same URL to keep one style.
VITE_MAP_STYLE_DARK=https://tiles.openfreemap.org/styles/dark
